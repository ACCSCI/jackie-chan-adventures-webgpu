[
 {
  "who": "thug",
  "text": "有人闯进来了！",
  "ep": 4,
  "id": "cffb06a279"
 },
 {
  "who": "thug",
  "text": "在这儿！",
  "ep": 4,
  "id": "5ab8a1c1e2"
 },
 {
  "who": "thug",
  "text": "是成龙！呼叫总部！",
  "ep": 4,
  "id": "89bae6b5de"
 },
 {
  "who": "narr",
  "text": "第四集 · 鼠之护身符",
  "ep": 4,
  "id": "b10dc7f8a7"
 },
 {
  "who": "jade",
  "text": "成龙！布莱克上尉的电话！他说十万火急！",
  "ep": 4,
  "id": "1f034d9f15"
 },
 {
  "who": "black",
  "text": "成龙，第十三区的地下基地出事了。黑手帮的拉索混了进来——他手里有鼠之护身符。",
  "ep": 4,
  "id": "fe572e140d"
 },
 {
  "who": "uncle",
  "text": "鼠符！拿着它的人能让没有生命的东西活过来！石头、铜像、机器……统统会动！",
  "ep": 4,
  "id": "ab0fe4bf49"
 },
 {
  "who": "jackie",
  "text": "机器？上尉，你们基地里不是有很多……",
  "ep": 4,
  "id": "4c8a074ef8"
 },
 {
  "who": "black",
  "text": "没错。还有我们最新的安保机甲 T-13。它会学习对手的战斗习惯——要是被拉索唤醒……",
  "ep": 4,
  "id": "f579c39452"
 },
 {
  "who": "black",
  "text": "更糟的是，他的人穿着我们的制服，控制了外围。警报一响，他们就会带着护身符跑掉。",
  "ep": 4,
  "id": "d3efe3f5b4"
 },
 {
  "who": "jackie",
  "text": "所以我得……偷偷溜进去。",
  "ep": 4,
  "id": "232804105d"
 },
 {
  "who": "uncle",
  "text": "一定要把鼠符拿回来！还有，不许碰坏第十三区的东西——我们赔不起！",
  "ep": 4,
  "id": "ca320b4591"
 },
 {
  "who": "jade",
  "text": "我也去！我最会躲猫猫了！",
  "ep": 4,
  "id": "cf19857932"
 },
 {
  "who": "jackie",
  "text": "不行。",
  "ep": 4,
  "id": "a9e235f296"
 },
 {
  "who": "narr",
  "text": "第十三区 · 地下基地 · 外围仓储区",
  "ep": 4,
  "id": "02c457e903"
 },
 {
  "who": "black",
  "text": "我是布莱克。听得到吗？摄像头被他们黑了，守卫全是假的。",
  "ep": 4,
  "id": "01ac0dba35"
 },
 {
  "who": "black",
  "text": "守卫头上的“？”涨满就会变成“！”。按 C 蹲下走路没有声音，躲在矮箱子后面蹲着就看不见你。",
  "ep": 4,
  "id": "678acbb2b3"
 },
 {
  "who": "black",
  "text": "从背后靠近按 F 可以悄悄放倒他们。被发现了，就赶在他用无线电呼叫之前把他打倒！",
  "ep": 4,
  "id": "1d0301d001"
 },
 {
  "who": "black",
  "text": "门口有激光绊线：低的跳过去，高的蹲着钻过去。大厅西墙有电闸，拉下来摄像头就瞎了。",
  "ep": 4,
  "id": "afcc8e20e5"
 },
 {
  "who": "black",
  "text": "目标是最里面的金库控制台。北边还有一条通风暗道，可以绕开大厅。",
  "ep": 4,
  "id": "87f4b1783f"
 },
 {
  "who": "jackie",
  "text": "（小声）明白……成龙式潜入，开始。",
  "ep": 4,
  "id": "6b07409a4d"
 },
 {
  "who": "narr",
  "text": "（金库里堆满了第十三区收缴的各种古怪证物）",
  "ep": 4,
  "id": "75c93f17e1"
 },
 {
  "who": "jackie",
  "text": "兵马俑？石狮子？上尉，你们这里是博物馆吗？",
  "ep": 4,
  "id": "c4918e083b"
 },
 {
  "who": "black",
  "text": "是“超自然证物库”。别乱碰任何东西。",
  "ep": 4,
  "id": "162c922643"
 },
 {
  "who": "ratso",
  "text": "嘿嘿嘿，晚了一步，成龙！",
  "ep": 4,
  "id": "ba432bc956"
 },
 {
  "who": "ratso",
  "text": "老大说了，鼠符能让死东西活过来。你看好了——",
  "ep": 4,
  "id": "8b845efc0f"
 },
 {
  "who": "narr",
  "text": "（拉索举起一块刻着老鼠的护身符，一道绿光扫过整个仓库）",
  "ep": 4,
  "id": "15f4937a0e"
 },
 {
  "who": "narr",
  "text": "（陶俑的眼睛亮了，架子上的铜鼠吱吱乱叫着跳了下来）",
  "ep": 4,
  "id": "fcb787652b"
 },
 {
  "who": "ratso",
  "text": "陪它们玩吧！我还要去叫醒那个大家伙！",
  "ep": 4,
  "id": "4597bddfcb"
 },
 {
  "who": "narr",
  "text": "（拉索一溜烟钻进了后门）",
  "ep": 4,
  "id": "bfbb5e6a8b"
 },
 {
  "who": "jackie",
  "text": "陶俑……不是应该在西安吗？！",
  "ep": 4,
  "id": "d4cc84df85"
 },
 {
  "who": "black",
  "text": "陶俑很硬，普通拳脚打不动，用重击（右键）！",
  "ep": 4,
  "id": "f980c7a863"
 },
 {
  "who": "narr",
  "text": "（仓库中央，镇墓石狮“咔啦啦”地抖落一身灰尘）",
  "ep": 4,
  "id": "870728fd8b"
 },
 {
  "who": "jackie",
  "text": "好狗狗……好狮子……",
  "ep": 4,
  "id": "6cdef55988"
 },
 {
  "who": "black",
  "text": "成龙，看地上的红色预警：直线是冲撞，圆圈是扑击。红色的挡不住，只能躲！",
  "ep": 4,
  "id": "76e3141761"
 },
 {
  "who": "black",
  "text": "琥珀色的扇形是爪击，可以格挡——完美格挡还能让它露出破绽。",
  "ep": 4,
  "id": "c8ddcc51f1"
 },
 {
  "who": "jade",
  "text": "成龙！让它撞柱子！它撞晕了就不能还手！",
  "ep": 4,
  "id": "0c388ecdf8"
 },
 {
  "who": "jackie",
  "text": "小玉？！你怎么进来的？！",
  "ep": 4,
  "id": "b477667633"
 },
 {
  "who": "jade",
  "text": "通风管道啊，你刚才不是也爬过？",
  "ep": 4,
  "id": "b2e116348a"
 },
 {
  "who": "narr",
  "text": "（石狮碎成了一地石块。远处传来升降机启动的轰鸣）",
  "ep": 4,
  "id": "6b9088c06e"
 },
 {
  "who": "black",
  "text": "拉索往货运升降井去了，他要去地面的停机坪！成龙，上平台！",
  "ep": 4,
  "id": "5b797faecd"
 },
 {
  "who": "jade",
  "text": "等等我！",
  "ep": 4,
  "id": "a94f6e8bb8"
 },
 {
  "who": "narr",
  "text": "第十三区 · 货运升降井",
  "ep": 4,
  "id": "d398d56958"
 },
 {
  "who": "narr",
  "text": "（平台一路向上，井壁飞快地往下掠过）",
  "ep": 4,
  "id": "03df613375"
 },
 {
  "who": "jackie",
  "text": "上尉，平台上为什么有你们的无人机？",
  "ep": 4,
  "id": "628fdf0059"
 },
 {
  "who": "black",
  "text": "……它们也被鼠符“唤醒”了。瞄准线变亮就要开火——可以格挡，完美格挡能把光弹打回去！",
  "ep": 4,
  "id": "1169f46bab"
 },
 {
  "who": "black",
  "text": "它们飞在半空：跳起来打，或者用弹回去的光弹把它们打下来。",
  "ep": 4,
  "id": "92771d0f37"
 },
 {
  "who": "jade",
  "text": "还有头顶！忍者会从上面跳下来——看地上的红圈！",
  "ep": 4,
  "id": "374efad826"
 },
 {
  "who": "narr",
  "text": "（平台冲出地面——停机坪上，一艘黑色飞艇正在升空）",
  "ep": 4,
  "id": "9ef3f75d00"
 },
 {
  "who": "jackie",
  "text": "是黑手帮的飞艇！",
  "ep": 4,
  "id": "5f3e259e62"
 },
 {
  "who": "jade",
  "text": "快跳！",
  "ep": 4,
  "id": "a9eced84d9"
 },
 {
  "who": "narr",
  "text": "云端 · 黑手帮飞艇甲板",
  "ep": 4,
  "id": "c903b46862"
 },
 {
  "who": "ratso",
  "text": "你还真是阴魂不散啊，成龙！兄弟们，一起上，把他扔下去！",
  "ep": 4,
  "id": "95f1af7c9d"
 },
 {
  "who": "black",
  "text": "成龙，他们会包抄你——别被围在中间。还有侧风：看到青色的风带就按 C 蹲下抓稳！",
  "ep": 4,
  "id": "4fea721b6e"
 },
 {
  "who": "jackie",
  "text": "我恐高……我恐高……我恐高……",
  "ep": 4,
  "id": "cd2b612f18"
 },
 {
  "who": "narr",
  "text": "（拉索摔在一个巨大的货箱旁边，货箱上印着“T-13”）",
  "ep": 4,
  "id": "653fd78ef9"
 },
 {
  "who": "ratso",
  "text": "你打得赢我……可打不赢它！",
  "ep": 4,
  "id": "69a1cbc01c"
 },
 {
  "who": "narr",
  "text": "（鼠之护身符飞进货箱——箱板炸开，T-13 的面罩亮起了红光）",
  "ep": 4,
  "id": "5e76322a21"
 },
 {
  "who": "t13",
  "text": "T-13，启动。目标：成龙。开始采集战斗数据。",
  "ep": 4,
  "id": "2da17d8b0f"
 },
 {
  "who": "black",
  "text": "成龙，T-13 会学你的习惯！你老用同一招，它就会专门针对你。",
  "ep": 4,
  "id": "5d8c24e5a7"
 },
 {
  "who": "black",
  "text": "右边的面板能看到它分析到哪一步了——经常换打法，它就会把数据忘掉。",
  "ep": 4,
  "id": "4e4d3d7f54"
 },
 {
  "who": "jade",
  "text": "成龙！它砸地以后会冒烟，那时候狠狠打！",
  "ep": 4,
  "id": "ec7f5ba9a1"
 },
 {
  "who": "jackie",
  "text": "一台会学习的机器人……我考驾照都考了三次！",
  "ep": 4,
  "id": "3f340b6499"
 },
 {
  "who": "narr",
  "text": "（T-13 单膝跪倒，胸口的鼠之护身符“啪”地弹了出来）",
  "ep": 4,
  "id": "3a9db957b0"
 },
 {
  "who": "t13",
  "text": "分析……失败……对手……无法……预测……",
  "ep": 4,
  "id": "ba6f6c2773"
 },
 {
  "who": "jackie",
  "text": "当然无法预测——我自己都不知道下一招出什么。",
  "ep": 4,
  "id": "b35c82758a"
 },
 {
  "who": "narr",
  "text": "（成龙接住鼠之护身符。云层下面，第十三区的直升机赶到了）",
  "ep": 4,
  "id": "a59abb95ad"
 },
 {
  "who": "black",
  "text": "干得漂亮，成龙。T-13 我们会带回去……重新编程。",
  "ep": 4,
  "id": "cd202df209"
 },
 {
  "who": "jade",
  "text": "能不能把它编程成会写作业的？",
  "ep": 4,
  "id": "5dd440342d"
 },
 {
  "who": "uncleP",
  "text": "鼠符拿回来了？好！四个了，还有八个！",
  "ep": 4,
  "id": "353aca0778"
 },
 {
  "who": "uncleP",
  "text": "还有！第十三区打电话来，说你打碎了他们一只石狮子！",
  "ep": 4,
  "id": "a2d2f7eaa0"
 },
 {
  "who": "jackie",
  "text": "是它先动的手！",
  "ep": 4,
  "id": "8de4fedcf5"
 },
 {
  "who": "uncleP",
  "text": "从你工资里扣！",
  "ep": 4,
  "id": "ebb91e732c"
 },
 {
  "who": "jade",
  "text": "哈哈哈哈！",
  "ep": 4,
  "id": "2977ff5257"
 },
 {
  "who": "jackie",
  "text": " }; return r.k === ",
  "ep": 4,
  "id": "1d27d2b952"
 },
 {
  "who": "jackie",
  "text": "第十三区的基地……总算混过去了。",
  "ep": 4,
  "id": "25daaca538"
 },
 {
  "who": "jackie",
  "text": "而且……基地里一个人都没发现我！",
  "ep": 4,
  "id": "30f1057889"
 },
 {
  "who": "jackie",
  "text": "shadow",
  "ep": 4,
  "id": "c5800506d3"
 },
 {
  "who": "jackie",
  "text": "基地那边……我只被发现了一点点。",
  "ep": 4,
  "id": "5d4e3085cc"
 },
 {
  "who": "jackie",
  "text": "基地里的警报……可能是我弄响的。",
  "ep": 4,
  "id": "a73624be01"
 },
 {
  "who": "finn",
  "text": "兄弟们，把他推下去！",
  "ep": 5,
  "id": "ae48cb0f43"
 },
 {
  "who": "ratso",
  "text": "嘿嘿，这上面风可大了！",
  "ep": 5,
  "id": "f62698b536"
 },
 {
  "who": "uncleP",
  "text": "笨！要等他站到钟底下再拉！",
  "ep": 5,
  "id": "50b260d5ed"
 },
 {
  "who": "tohru",
  "text": "放我出去！",
  "ep": 5,
  "id": "b2e7005844"
 },
 {
  "who": "tohru",
  "text": "影武者——出来！",
  "ep": 5,
  "id": "c8be8b9f71"
 },
 {
  "who": "darkj",
  "text": "影子……都是我的影子。",
  "ep": 5,
  "id": "c586db8c34"
 },
 {
  "who": "darkj",
  "text": "这一套，是你的。",
  "ep": 5,
  "id": "dbe43d6cc9"
 },
 {
  "who": "darkj",
  "text": "你就只会这些？",
  "ep": 5,
  "id": "1b42e60967"
 },
 {
  "who": "darkj",
  "text": "我学得比你快。",
  "ep": 5,
  "id": "79822da79f"
 },
 {
  "who": "narr",
  "text": "第五集 · 虎之护身符",
  "ep": 5,
  "id": "5be9ca86ea"
 },
 {
  "who": "uncle",
  "text": "找到了！虎之护身符——就在喜马拉雅山上的一座古寺里！",
  "ep": 5,
  "id": "344a8a4ac8"
 },
 {
  "who": "jackie",
  "text": "喜马拉雅山？那里很冷吧……",
  "ep": 5,
  "id": "22a2d0a3ff"
 },
 {
  "who": "uncle",
  "text": "冷不冷不重要！虎符有阴阳之力，能把一个人分成好的一半和坏的一半！",
  "ep": 5,
  "id": "dc8e194213"
 },
 {
  "who": "jade",
  "text": "那成龙坏的那一半，会不会比较酷？",
  "ep": 5,
  "id": "7e0b3bee8d"
 },
 {
  "who": "jackie",
  "text": "小玉！",
  "ep": 5,
  "id": "730d697a85"
 },
 {
  "who": "uncle",
  "text": "听好！拿虎符的时候一定要用布包着，千万不能用手直接碰！一定要！",
  "ep": 5,
  "id": "39d722c528"
 },
 {
  "who": "jackie",
  "text": "知道了，用布包着。",
  "ep": 5,
  "id": "a1ff5b14d6"
 },
 {
  "who": "uncle",
  "text": "还有！黑手帮也在找它——刀鲁已经先上山了。",
  "ep": 5,
  "id": "e3255cefa2"
 },
 {
  "who": "jade",
  "text": "我也去！我最会堆雪人了！",
  "ep": 5,
  "id": "e20b65d242"
 },
 {
  "who": "narr",
  "text": "喜马拉雅山 · 悬崖栈道",
  "ep": 5,
  "id": "5061ab304e"
 },
 {
  "who": "jackie",
  "text": "好冷……好高……好冷……",
  "ep": 5,
  "id": "51dddde381"
 },
 {
  "who": "thug",
  "text": "成龙来了！老大说了，一个都别让他过去！",
  "ep": 5,
  "id": "e6a32beb08"
 },
 {
  "who": "uncleP",
  "text": "成龙！听得见吗？栈道外面就是悬崖——在崖边用重击，就能把他们打下山！",
  "ep": 5,
  "id": "310be8fc8e"
 },
 {
  "who": "uncleP",
  "text": "山上风大，青色的风带过来就蹲下！红线是落石，滚过来的时候赶快躲开！",
  "ep": 5,
  "id": "1406bb7eb3"
 },
 {
  "who": "jackie",
  "text": "老爹，你怎么什么都知道？",
  "ep": 5,
  "id": "d3ee32b4a7"
 },
 {
  "who": "uncleP",
  "text": "我上网查的！一定要！小心！",
  "ep": 5,
  "id": "84a29968cf"
 },
 {
  "who": "narr",
  "text": "（栈道的尽头，一座积雪的古寺静静地立在山顶）",
  "ep": 5,
  "id": "c45c556148"
 },
 {
  "who": "jackie",
  "text": "……终于到了。我的脚趾头已经没感觉了。",
  "ep": 5,
  "id": "d60e7d512c"
 },
 {
  "who": "narr",
  "text": "喜马拉雅山 · 雪峰寺",
  "ep": 5,
  "id": "df3c9dac99"
 },
 {
  "who": "tohru",
  "text": "成龙。你不能过去。",
  "ep": 5,
  "id": "76a98bfe4b"
 },
 {
  "who": "jackie",
  "text": "刀鲁！这么冷的天，你还穿这么少？",
  "ep": 5,
  "id": "4a490d9b1d"
 },
 {
  "who": "tohru",
  "text": "虎之护身符属于圣主。",
  "ep": 5,
  "id": "cb7427850e"
 },
 {
  "who": "uncleP",
  "text": "成龙！寺里那口大钟——引他站到钟底下，拉断钟绳，把刀鲁罩住！",
  "ep": 5,
  "id": "7e90abcc08"
 },
 {
  "who": "uncleP",
  "text": "小心！那口钟有八百年历史，不许砸坏！",
  "ep": 5,
  "id": "a9062b99a0"
 },
 {
  "who": "jackie",
  "text": "老爹，到底是要用钟砸他，还是不许砸坏？",
  "ep": 5,
  "id": "98c1bec13a"
 },
 {
  "who": "uncleP",
  "text": "都要！",
  "ep": 5,
  "id": "3a989b5f68"
 },
 {
  "who": "narr",
  "text": "（刀鲁倒在雪地里。大钟里“叮”的一声，滚出一枚闪着金光的护身符）",
  "ep": 5,
  "id": "07a923bb0e"
 },
 {
  "who": "jackie",
  "text": "虎之护身符！",
  "ep": 5,
  "id": "19ce877fe5"
 },
 {
  "who": "uncleP",
  "text": "用布包着！千万不能用手——",
  "ep": 5,
  "id": "5dce67d671"
 },
 {
  "who": "jackie",
  "text": "布……布……我的布在哪……",
  "ep": 5,
  "id": "777fac45a1"
 },
 {
  "who": "narr",
  "text": "（成龙一把抓住了护身符——一道金光闪过，把他劈成了两半）",
  "ep": 5,
  "id": "1ceda005f2"
 },
 {
  "who": "darkj",
  "text": "终于……自由了。",
  "ep": 5,
  "id": "82435e4549"
 },
 {
  "who": "jackie",
  "text": "你……你是谁？",
  "ep": 5,
  "id": "7694d317fe"
 },
 {
  "who": "darkj",
  "text": "我就是你。你心里那个，不想再当好人的成龙。",
  "ep": 5,
  "id": "222df65090"
 },
 {
  "who": "darkj",
  "text": "你总是在道歉、在帮忙、在逃跑……我受够了。护身符，归我了！",
  "ep": 5,
  "id": "64bbdf9d3a"
 },
 {
  "who": "narr",
  "text": "（黑成龙夺过护身符，几个起落跳上了后山的阴阳台）",
  "ep": 5,
  "id": "858c0394be"
 },
 {
  "who": "uncleP",
  "text": "糟了糟了！虎符把你的阴和阳分开了！",
  "ep": 5,
  "id": "abc434dbc7"
 },
 {
  "who": "uncleP",
  "text": "要把你们合回一个人，就要攻守平衡！只攻不守、只守不攻，都打不赢他！",
  "ep": 5,
  "id": "0ea2bc571d"
 },
 {
  "who": "narr",
  "text": "后山 · 阴阳台（夜）",
  "ep": 5,
  "id": "9d29ce1d4d"
 },
 {
  "who": "darkj",
  "text": "来吧。你所有的招式我都知道——因为它们也是我的。",
  "ep": 5,
  "id": "4716a7090e"
 },
 {
  "who": "jackie",
  "text": "那你一定也知道……我很怕痛。",
  "ep": 5,
  "id": "a8951b6e51"
 },
 {
  "who": "darkj",
  "text": "所以这一次，我先出手。",
  "ep": 5,
  "id": "1d3173518e"
 },
 {
  "who": "uncleP",
  "text": "成龙！看上面的阴阳盘！打一打、守一守，保持平衡，才伤得了他！",
  "ep": 5,
  "id": "5322b3131a"
 },
 {
  "who": "uncleP",
  "text": "还有！他会学你的招式——你出什么，他就还你什么！",
  "ep": 5,
  "id": "598143e9b7"
 },
 {
  "who": "narr",
  "text": "（黑成龙单膝跪地，身上的黑雾一阵阵散开）",
  "ep": 5,
  "id": "37271a9253"
 },
 {
  "who": "darkj",
  "text": "为什么……你明明那么胆小……",
  "ep": 5,
  "id": "ad1c099c43"
 },
 {
  "who": "jackie",
  "text": "我是胆小。可是我每次都会站起来——你就是我，所以你也会。",
  "ep": 5,
  "id": "8eea02a448"
 },
 {
  "who": "narr",
  "text": "（两个成龙同时握住了虎之护身符。金光和黑影卷成一个太极——合二为一）",
  "ep": 5,
  "id": "612c2f1663"
 },
 {
  "who": "jackie",
  "text": "……我回来了。完完整整的我。",
  "ep": 5,
  "id": "3065d3b45d"
 },
 {
  "who": "narr",
  "text": "（夜空里传来直升机的轰鸣，一束探照灯打在阴阳台上）",
  "ep": 5,
  "id": "6c17763502"
 },
 {
  "who": "jade",
  "text": "成龙！布莱克上尉的直升机可快了！",
  "ep": 5,
  "id": "f11b10ab8c"
 },
 {
  "who": "jackie",
  "text": "小玉？！你怎么——",
  "ep": 5,
  "id": "1e5057a846"
 },
 {
  "who": "jade",
  "text": "我跟上尉说你需要后援。我就是后援！",
  "ep": 5,
  "id": "970117059b"
 },
 {
  "who": "uncleP",
  "text": "虎符拿回来了？好！五个了，还有七个！",
  "ep": 5,
  "id": "2c0422b403"
 },
 {
  "who": "uncleP",
  "text": "还有！以后不许再跟自己吵架！",
  "ep": 5,
  "id": "15a62e1488"
 },
 {
  "who": "jackie",
  "text": "……是，老爹。",
  "ep": 5,
  "id": "73f9858620"
 }
]